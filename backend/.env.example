# Copie para .env e preencha. NUNCA versione o .env.
# Conexão com o Supabase (Project Settings > Database).
# Se a conexão direta falhar (IPv6), use a string do "Session pooler".
DB_URL=jdbc:postgresql://HOST:5432/postgres
DB_USERNAME=
DB_PASSWORD=

# Chave Base64 com pelo menos 32 bytes. Gere com: openssl rand -base64 32
JWT_SECRET=
# Validade do token em milissegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000

# Origem do front-end (separe várias por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173
