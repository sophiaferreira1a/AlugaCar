# Supabase — Session Pooler (recomendado para Hibernate)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<região>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=sua-senha-do-banco

# Alternativa: conexão direta
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres

# Transaction Pooler (porta 6543) exige prepareThreshold=0:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<região>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0

JWT_SECRET=base64-de-uma-chave-de-no-minimo-32-bytes
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_SHOW_SQL=false