@startuml diagrama-pacotes
!pragma layout smetana

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #2E6DA4
}

package "com.lab.alugacar" {
  package "controller" as controller
  package "service" as service
  package "repository" as repository
  package "model" as model
  package "dto" as dto
  package "security" as security
  package "exception" as exception
  package "config" as config
}

controller ..> service : usa
controller ..> dto
service ..> repository : consulta/persiste
service ..> model
service ..> dto
service ..> exception : lança
service ..> security : emite JWT
repository ..> model
dto ..> model : converte entidades
security ..> repository
security ..> model

note bottom of model
  Camada de domínio: não depende
  de nenhum outro pacote.
end note

note bottom of config
  Reservado para configurações.
  Hoje a SecurityConfig fica em security.
end note

@enduml
